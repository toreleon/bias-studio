# Copy to .env.local on your server. Never commit real credentials.
OPENAI_API_KEY=
GENERATION_MODEL=gpt-image-2.6-sunburst
BETA_DB=./server/data/beta.sqlite
BETA_HOST=127.0.0.1
BETA_PORT=8788
BETA_PUBLIC_URL=http://localhost:8788
BETA_WEB_ORIGIN=http://localhost:8081
BETA_CREATOR_DAILY_LIMIT=20
BETA_DAILY_LIMIT=100
# Configured reservations in micro-USD; not measured provider charges.
BETA_RESERVATION_MICROS=50000
BETA_DAILY_BUDGET_MICROS=5000000
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
