{
  "name": "bias-studio",
  "version": "1.3.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node --test tests/generation-service.test.mjs tests/beta-*.test.mjs",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "prebuild": "expo prebuild",
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "expo lint --max-warnings 0",
    "test:release": "node --test tests/release-policy.test.mjs",
    "github:protect": "node scripts/configure-github.mjs",
    "generation:serve": "node --env-file=server/.env.local server/generation.mjs",
    "beta:serve": "node --env-file=server/.env.local server/beta-server.mjs",
    "beta:invite": "node --env-file=server/.env.local server/beta-admin.mjs invite",
    "beta:backup": "node --env-file=server/.env.local server/beta-admin.mjs backup"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "expo-video-thumbnails": "~58.0.3",
    "fan-stickers": "file:modules/fan-stickers",
    "fflate": "^0.8.3",
    "lucide-react-native": "^1.73.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
